% Model overview, used by main.tex and by pipeline_standalone.tex (slides).
% Needs: tikz with libraries positioning, arrows.meta.
\begin{tikzpicture}[
  node distance=4mm and 5mm,
  box/.style={draw, rounded corners=2pt, align=center, minimum height=9mm,
              font=\footnotesize, inner sep=3pt},
  frozen/.style={box, fill=blue!10},
  stageone/.style={box, fill=orange!18},
  stagetwo/.style={box, fill=green!15},
  data/.style={box, draw=black!50, fill=white},
  arr/.style={-{Stealth[length=2mm]}, thick},
  bridge/.style={arr, preaction={draw, white, line width=4pt, -}},
  key/.style={box, minimum height=4mm, font=\scriptsize}]
  % Video branch.
  \node[data] (vid) {Video\\ 16 ordered frames};
  \node[frozen, right=of vid] (enc) {V-JEPA 2\\ ViT-L};
  \node[data, right=of enc] (states) {States\\ $z_1,\dots,z_T$};
  \node[data, right=of states] (tok) {Tokens $[z_t;\,\Delta z_t]$\\
        $\Delta z_t = z_{t+1}-z_t$};
  \node[stageone, right=of tok] (tr) {Temporal\\ Transformer};
  \node[data, right=7mm of tr, yshift=7mm] (pool) {pooled $\bar{\mathbf v}$};
  \node[data, right=7mm of tr, yshift=-7mm] (htok) {tokens $\hat h_t$};
  \node[stageone, right=10mm of pool] (cos) {$\tau\cos(\mathbf t,\bar{\mathbf v})$};
  % Text branch.
  \node[data, below=18mm of vid] (txt) {Query $q$};
  \node[frozen] (lm) at (enc |- txt) {MiniLM};
  \node[stageone] (proj) at (tok |- txt) {Linear + LN};
  \node[data] (t) at (cos |- txt) {$\mathbf t$};
  % Token-level matcher.
  \node[stagetwo, right=8mm of t] (xattn) {Cross-attention\\ $\mathbf t$ over $\hat h_t$ $\to\mathbf a_q$};
  \node[stagetwo, right=5mm of xattn] (mlp)
       {MLP $g$ on\\ $[\mathbf t,\mathbf a_q,\mathbf t\odot\mathbf a_q,|\mathbf t-\mathbf a_q|]$};
  \node[box, circle, minimum height=6mm, inner sep=1pt, right=5mm of mlp] (sum) {$+$};
  \node[data, right=5mm of sum] (score) {$s(q,v)$};
  % Arrows.
  \draw[arr] (vid) -- (enc);
  \draw[arr] (enc) -- (states);
  \draw[arr] (states) -- (tok);
  \draw[arr] (tok) -- (tr);
  \draw[arr] (tr.east) -- ++(3mm,0) |- (pool.west);
  \draw[arr] (tr.east) -- ++(3mm,0) |- (htok.west);
  \draw[arr] (pool) -- (cos);
  \draw[arr] (htok.east) -| (xattn.north);
  \draw[arr] (txt) -- (lm);
  \draw[arr] (lm) -- (proj);
  \draw[arr] (proj) -- (t);
  \draw[bridge] (t) -- (cos);
  \draw[arr] (t) -- (xattn);
  \draw[arr] (xattn) -- (mlp);
  \draw[arr] (mlp) -- (sum);
  \draw[arr] (cos.east) -| (sum.north);
  \draw[arr] (sum) -- (score);
  % Legend.
  \node[frozen, key, below=5mm of txt.south west, anchor=north west] (k1) {frozen};
  \node[stageone, key, right=3mm of k1] (k2) {trained in stage 1};
  \node[stagetwo, key, right=3mm of k2] (k3) {trained in stage 2, stage 1 frozen};
  \node[font=\scriptsize, right=4mm of k3] {Control E1: tokens $[z_t;\,0]$ for
        $t=1,\dots,T$, everything else identical.};
\end{tikzpicture}
